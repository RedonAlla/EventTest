{
  "ConnectionStrings": {
    "EventTestSqliteConnectionString": "Data Source=EventTest.db"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Sensitive",
      "Serilog.Exceptions"
    ],
    "Enrich": [
      { "Name": "WithExceptionDetails" },
      {
        "Name": "WithSensitiveDataMasking",
        "Args": {
          "options": {
            "MaskValue": "***SECRET***",
            "MaskProperties": [
              {
                "Name": "password"
              },
              {
                "Name": "Authorization",
                "Options": {
                  "ShowFirst": 7,
                  "PreserveLength": false
                }
              }
            ],
            "Mode": "Globally"
          }
        }
      }
    ],
    "WriteTo:Async": {
      "Name": "Async",
      "Args": {
        "configure": [
          {
            "Name": "File",
            "Args": {
              "rollingInterval": "Day",
              "path": "Logs/EventTest-.log",
              "outputTemplate": "{Timestamp:G} [{Level}] ({XRequestId})({TraceId}) {Message:lj} ({SourceContext}){NewLine}{Exception}",
              "retainedFileCountLimit": null,
              "rollOnFileSizeLimit": true
            }
          },
          {
            "Name": "Console",
            "Args": {
              "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
              "outputTemplate": "{Timestamp:G} [{Level}] ({XRequestId})({TraceId}) {Message:lj} ({SourceContext}){NewLine}{Exception}"
            }
          }
        ]
      }
    },
    "Properties": {
      "ApplicationName": "EventTest"
    }
  },
  "OpenApiInfoSettings": {
    "Title": "EventTest API",
    "Summary": "API interfaces for developers and agents.",
    "Description": "Api documentation interface for EventTest. Here you can read and try each endpoint.",
    "Contact": {
        "Name": "API Support Team",
        "Url": "https://example.com/support",
        "Email": "support@example.com"
      },
      "License": {
        "Name": "MIT License",
        "Url": "https://opensource.org/licenses/MIT"
      }
  }
}
